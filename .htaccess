RewriteEngine On
RewriteBase /fagro/

# 1. Permite o acesso EXCLUSIVAMENTE às pastas da raiz (vistas nas suas imagens)
RewriteCond %{REQUEST_URI} ^/fagro/1-logs/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/bibagro/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/ccfa/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/dalc/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/download/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/eea/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/fitossanidade/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/floricultura/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/forrageiras/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/fotos/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpagrometeorologia/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpaquam/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpborbulheira/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpecologiadepastejo/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpposcolheita/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/gpsubstrato/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/grupofrota/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/horticultura/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/intranet/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labagrometeorologia/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labapi/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labapicultura/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labcitogenetica/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labposcolheita/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/labsubstratos/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/lezo/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/lna/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/materiais/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/nap/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/nau/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/NESPRO/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/nga/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/ninfa/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/novo/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/plantas/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/plantasdelavoura/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/ppgfitotecnia/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/ppgsolos/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/ppgzootecnia/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/solos/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/tsep/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/zootecnia/ [NC,OR]

# 2. Permite o acesso EXCLUSIVAMENTE às subpastas do Joomla
RewriteCond %{REQUEST_URI} ^/fagro/joomla/administrator/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/backup/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/bin/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/cache/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/cli/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/components/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/files/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/flash/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/images/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/includes/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/language/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/layouts/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/libraries/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/logs/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/media/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/modules/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/plugins/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/templates/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/tmp/ [NC,OR]

# 3. Permite o acesso a URLs e arquivos específicos adicionais
RewriteCond %{REQUEST_URI} ^/fagro/joomla/index\.php/labnutri-agendamentos [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/index\.php/logintranet [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/index\.php/ccfa [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/index\.php/intranet-do-departamento [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/joomla/index\.php/intranet [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/novo/intranet/logintranet\.php [NC,OR]
RewriteCond %{REQUEST_URI} ^/fagro/novo/intranet/admin_agro_joomla\.php [NC]
RewriteRule ^ - [L]

# 4. Evita loop caso acesse diretamente a URL de destino
RewriteCond %{HTTP_HOST}%{REQUEST_URI} !^www\.ufrgs\.br/fagroz/?$ [NC]

# 5. Redireciona TODO O RESTO para a URL informada
RewriteRule ^ https://www.ufrgs.br/fagroz/ [R=301,L]
